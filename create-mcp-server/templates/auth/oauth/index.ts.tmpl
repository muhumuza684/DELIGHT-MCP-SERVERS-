import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import { z } from "zod";
import { TokenManager } from "./oauth.js";

// ---------------------------------------------------------------------------
// Config — fill these in from your provider's OAuth app settings.
// ---------------------------------------------------------------------------
const CLIENT_ID = process.env.{{PROVIDER_ENV_PREFIX}}_CLIENT_ID;
const CLIENT_SECRET = process.env.{{PROVIDER_ENV_PREFIX}}_CLIENT_SECRET;
const REDIRECT_PORT = (() => {
  const n = Number(process.env.OAUTH_REDIRECT_PORT ?? 8737);
  return Number.isFinite(n) ? n : 8737;
})();
const TOKEN_FILE = process.env.TOKEN_FILE ?? "./.{{SERVER_SLUG}}-tokens.json";

if (!CLIENT_ID || !CLIENT_SECRET) {
  console.error(
    "FATAL: {{PROVIDER_ENV_PREFIX}}_CLIENT_ID and {{PROVIDER_ENV_PREFIX}}_CLIENT_SECRET must be set."
  );
  process.exit(1);
}

const tokenManager = new TokenManager({
  authorizeUrl: "https://REPLACE_ME/oauth/authorize",
  tokenUrl: "https://REPLACE_ME/oauth/token",
  clientId: CLIENT_ID,
  clientSecret: CLIENT_SECRET,
  scopes: ["REPLACE_ME_WITH_REAL_SCOPES"],
  redirectPort: REDIRECT_PORT,
  tokenFile: TOKEN_FILE,
  usesPkce: true, // check your provider's docs — not all providers support/require this
  // tokenAuthStyle: "basic_json", // uncomment if form-urlencoded token exchange fails
  // extraAuthParams: { access_type: "offline", prompt: "consent" }, // Google-style, if needed
});

async function apiRequest(url: string, init: RequestInit = {}) {
  const token = await tokenManager.getAccessToken();
  const res = await fetch(url, {
    ...init,
    headers: { ...init.headers, Authorization: `Bearer ${token}` },
  });
  if (!res.ok) {
    const text = await res.text();
    throw new Error(`API error ${res.status}: ${text.slice(0, 400)}`);
  }
  return res.json();
}

function toolError(message: string) {
  return { content: [{ type: "text" as const, text: `Error: ${message}` }], isError: true };
}
function textResult(data: unknown) {
  return {
    content: [
      {
        type: "text" as const,
        text: typeof data === "string" ? data : JSON.stringify(data, null, 2),
      },
    ],
  };
}

// ---------------------------------------------------------------------------
// Server
// ---------------------------------------------------------------------------
const server = new McpServer({ name: "{{SERVER_NAME}}", version: "1.0.0" });

server.registerTool(
  "example_tool",
  {
    title: "Example tool",
    description: "Replace this with a real read tool that calls apiRequest().",
    inputSchema: {
      input: z.string().describe("Replace with real parameters"),
    },
  },
  async ({ input }) => {
    try {
      // TODO: const data = await apiRequest(`https://REPLACE_ME/some/endpoint`);
      return textResult({ echoed: input });
    } catch (err) {
      return toolError((err as Error).message);
    }
  }
);

// {{WRITE_TOOL_PLACEHOLDER}}

// ---------------------------------------------------------------------------
// Boot
// ---------------------------------------------------------------------------
async function main() {
  const transport = new StdioServerTransport();
  await server.connect(transport);
  console.error("{{SERVER_NAME}} running.");
}

main().catch((err) => {
  console.error("Fatal error starting {{SERVER_NAME}}:", err);
  process.exit(1);
});
