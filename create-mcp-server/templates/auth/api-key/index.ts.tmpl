#!/usr/bin/env node
/**
 * {{DISPLAY_NAME}}
 * -----------------------------------------------------------------------
 * Generated by create-mcp-server from the "body" + "API-key head"
 * templates. This head is proven across github-mcp-server,
 * postgres-mcp-server, and stripe-mcp-server in the original catalog —
 * the pattern is always: one secret in env, checked at boot with a
 * fatal exit if missing, and ONE wrapper function every tool routes
 * through (never call the underlying API/DB directly from a tool).
 * -----------------------------------------------------------------------
 */

import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import { z } from "zod";

// ---------------------------------------------------------------------------
// Config
// ---------------------------------------------------------------------------
const API_KEY = process.env.{{ENV_VAR_NAME}};
const API_BASE = process.env.API_BASE ?? "{{API_BASE_PLACEHOLDER}}";

if (!API_KEY) {
  console.error(
    "FATAL: {{ENV_VAR_NAME}} is not set. Set it to a scoped/restricted API key — " +
      "never a full-access admin key if the provider offers scoped ones."
  );
  process.exit(1);
}

// ---------------------------------------------------------------------------
// API wrapper — every tool goes through this, never raw fetch directly.
// Adjust the auth header style to match your provider's docs (Bearer is
// the most common, but check — e.g. Notion needs Basic + JSON, not this).
// ---------------------------------------------------------------------------
async function apiRequest(path: string, init: RequestInit = {}) {
  const res = await fetch(new URL(path, API_BASE), {
    ...init,
    headers: {
      Authorization: `Bearer ${API_KEY}`,
      "Content-Type": "application/json",
      ...init.headers,
    },
  });
  if (!res.ok) {
    const text = await res.text();
    throw new Error(`API error ${res.status}: ${text.slice(0, 400)}`);
  }
  return res.json();
}

function toolError(message: string) {
  return { content: [{ type: "text" as const, text: `Error: ${message}` }], isError: true };
}
function textResult(data: unknown) {
  return {
    content: [
      {
        type: "text" as const,
        text: typeof data === "string" ? data : JSON.stringify(data, null, 2),
      },
    ],
  };
}

// ---------------------------------------------------------------------------
// Server
// ---------------------------------------------------------------------------
const server = new McpServer({ name: "{{SERVER_NAME}}", version: "1.0.0" });

server.registerTool(
  "example_tool",
  {
    title: "Example tool",
    description: "Replace this with a real read tool that calls apiRequest().",
    inputSchema: {
      input: z.string().describe("Replace with real parameters"),
    },
  },
  async ({ input }) => {
    try {
      // TODO: const data = await apiRequest(`/some/endpoint?q=${encodeURIComponent(input)}`);
      return textResult({ echoed: input });
    } catch (err) {
      return toolError((err as Error).message);
    }
  }
);

// {{WRITE_TOOL_PLACEHOLDER}}

// ---------------------------------------------------------------------------
// Boot
// ---------------------------------------------------------------------------
async function main() {
  const transport = new StdioServerTransport();
  await server.connect(transport);
  console.error("{{SERVER_NAME}} running.");
}

main().catch((err) => {
  console.error("Fatal error starting {{SERVER_NAME}}:", err);
  process.exit(1);
});
